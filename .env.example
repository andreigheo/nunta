# Runtime
NODE_ENV=development
WEB_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
PORT=4000
LOG_LEVEL=info

# PostgreSQL. DATABASE_OWNER_URL is used only for migrations.
DATABASE_URL=postgresql://weddingos_app:weddingos_app@127.0.0.1:54339/weddingos?schema=public
DATABASE_OWNER_URL=postgresql://weddingos:weddingos@127.0.0.1:54339/weddingos?schema=public

# Authentication
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=weddingos_session
FEATURE_MAGIC_LINK_ENABLED=true
FEATURE_MFA_ENABLED=false

# Email / local Mailpit
EMAIL_FROM=WeddingOS <no-reply@weddingos.local>
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Durable async execution. Production requires authenticated rediss://.
REDIS_URL=redis://127.0.0.1:56379
OUTBOX_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OUTBOX_ENCRYPTION_KEY_ID=local-v1
OUTBOX_DECRYPTION_KEYS={}
OUTBOX_COMMAND_TTL_SECONDS=604800
WORKER_STALE_AFTER_SECONDS=45
MARKETING_SNAPSHOT_INTERVAL_SECONDS=900
MARKETING_SNAPSHOT_WINDOW_DAYS=365
MARKETING_SNAPSHOT_MIN_COHORT=20
MARKETING_SNAPSHOT_MAX_STALE_SECONDS=86400
ARTIFACT_ROOT=ops/artifacts/activity-exports
ARTIFACT_RETENTION_HOURS=24
ARTIFACT_MAX_BYTES=5242880
ARTIFACT_MAX_ROWS=10000

# Optional AI enrichment adapter. When absent or unavailable, generation falls
# back to the deterministic provider and reports the fallback to the user.
PLAN_GENERATION_PROVIDER_URL=
PLAN_GENERATION_PROVIDER_KEY=
PLAN_GENERATION_PROVIDER_MODEL=configured

# Private S3-compatible storage and malware scanning
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=weddingos-private
OBJECT_STORAGE_ACCESS_KEY=weddingos
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-storage-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_MAX_BYTES=26214400
PORTFOLIO_IMAGE_MAX_BYTES=15728640
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
CLAMAV_SCAN_TIMEOUT_MS=30000

# Provider-hosted signature and payment adapters. Fake is development/test only.
SIGNATURE_PROVIDER=fake
SIGNATURE_PROVIDER_URL=
SIGNATURE_PROVIDER_SECRET=replace-with-a-long-signature-webhook-secret
PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_SECRET=replace-with-a-long-payment-webhook-secret
SUBSCRIPTION_PROVIDER=fake
SUBSCRIPTION_PROVIDER_URL=
SUBSCRIPTION_PROVIDER_SECRET=replace-with-a-long-subscription-webhook-secret
PAYOUT_PROVIDER=fake
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_SECRET=replace-with-a-long-payout-webhook-secret
REVIEW_EDIT_WINDOW_DAYS=30
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM_MINOR=10000
PROVIDER_WEBHOOK_TOLERANCE_SECONDS=300

# Server-only Next.js rewrite target. Browser requests stay same-origin on /api/v1.
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEMO_MODE_ENABLED=true
