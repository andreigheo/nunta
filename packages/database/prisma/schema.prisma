model User {
  id                             String                     @id @default(uuid()) @db.Uuid
  email                          String                     @unique @db.VarChar(320)
  emailVerifiedAt                DateTime?                  @map("email_verified_at")
  status                         UserStatus                 @default(ACTIVE)
  acceptedTermsVersion           String                     @map("accepted_terms_version") @db.VarChar(40)
  acceptedTermsAt                DateTime                   @map("accepted_terms_at")
  marketingConsent               Boolean                    @default(false) @map("marketing_consent")
  createdAt                      DateTime                   @default(now()) @map("created_at")
  updatedAt                      DateTime                   @updatedAt @map("updated_at")
  version                        Int                        @default(1)
  profile                        UserProfile?
  identities                     Identity[]
  sessions                       Session[]
  oneTimeTokens                  AuthOneTimeToken[]
  memberships                    WorkspaceMembership[]
  acceptedInvitations            TeamInvitation[]           @relation("InvitationAcceptedBy")
  preference                     UserPreference?
  notificationPreference         NotificationPreference?
  publicAggregateConsentsGranted PublicAggregateConsent[]   @relation("PublicAggregateConsentedBy")
  publicAggregateConsentsRevoked PublicAggregateConsent[]   @relation("PublicAggregateRevokedBy")
  copilotMemoriesCreated         CopilotMemory[]            @relation("CopilotMemoryCreatedBy")
  copilotMemoriesUpdated         CopilotMemory[]            @relation("CopilotMemoryUpdatedBy")
  copilotMemoriesOwned           CopilotMemory[]            @relation("CopilotMemoryOwner")
  copilotSettingsCreated         CopilotWorkspaceSettings[] @relation("CopilotSettingsCreatedBy")
  copilotSettingsUpdated         CopilotWorkspaceSettings[] @relation("CopilotSettingsUpdatedBy")
  copilotToolInvocations         CopilotToolInvocation[]

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name") @db.VarChar(80)
  lastName  String   @map("last_name") @db.VarChar(80)
  avatarUrl String?  @map("avatar_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Identity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String?          @map("provider_subject") @db.VarChar(320)
  passwordHash    String?          @map("password_hash") @db.VarChar(512)
  lastUsedAt      DateTime?        @map("last_used_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  version         Int              @default(1)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerSubject])
  @@index([provider, providerSubject])
  @@map("identities")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  remember   Boolean   @default(false)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  version    Int       @default(1)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model AuthOneTimeToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  codeHash   String?      @map("code_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  revokedAt  DateTime?    @map("revoked_at")
  attempts   Int          @default(0)
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  version    Int          @default(1)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, revokedAt])
  @@index([codeHash, purpose])
  @@map("auth_one_time_tokens")
}

model Workspace {
  id                      String                          @id @default(uuid()) @db.Uuid
  title                   String                          @db.VarChar(160)
  locale                  String                          @default("ro-RO") @db.VarChar(16)
  timezone                String                          @default("Europe/Bucharest") @db.VarChar(80)
  currency                String                          @default("RON") @db.Char(3)
  status                  WorkspaceStatus                 @default(ACTIVE)
  imageUrl                String?                         @map("image_url") @db.VarChar(2048)
  createdById             String                          @map("created_by") @db.Uuid
  updatedById             String                          @map("updated_by") @db.Uuid
  deletedAt               DateTime?                       @map("deleted_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  version                 Int                             @default(1)
  weddingProfile          WeddingProfile?
  memberships             WorkspaceMembership[]
  invitations             TeamInvitation[]
  auditEvents             AuditEvent[]
  idempotencyRecords      IdempotencyRecord[]
  publicAggregateConsent  PublicAggregateConsent?
  subscription            WorkspaceSubscription?
  billingCheckouts        WorkspaceBillingCheckout[]
  billingProviderEvents   WorkspaceBillingProviderEvent[]
  billingTransactions     WorkspaceBillingTransaction[]
  creativeState           WorkspaceCreativeState?
  copilotSettings         CopilotWorkspaceSettings?
  copilotMemories         CopilotMemory[]
  copilotMemoryEmbeddings CopilotMemoryEmbedding[]
  copilotToolInvocations  CopilotToolInvocation[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceSubscription {
  id                     String                       @id @default(uuid()) @db.Uuid
  workspaceId            String                       @unique @map("workspace_id") @db.Uuid
  planKey                WorkspaceSubscriptionPlanKey @default(FREE) @map("plan_key")
  status                 WorkspaceSubscriptionStatus  @default(FREE)
  provider               String?                      @db.VarChar(32)
  providerCustomerId     String?                      @map("provider_customer_id") @db.VarChar(64)
  providerSubscriptionId String?                      @unique @map("provider_subscription_id") @db.VarChar(64)
  providerPriceId        String?                      @map("provider_price_id") @db.VarChar(64)
  currentPeriodStart     DateTime?                    @map("current_period_start")
  currentPeriodEnd       DateTime?                    @map("current_period_end")
  cancelAtPeriodEnd      Boolean                      @default(false) @map("cancel_at_period_end")
  lastProviderEventAt    DateTime?                    @map("last_provider_event_at")
  lastReconciledAt       DateTime?                    @map("last_reconciled_at")
  createdById            String                       @map("created_by") @db.Uuid
  updatedById            String                       @map("updated_by") @db.Uuid
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  version                Int                          @default(1)
  workspace              Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([providerCustomerId])
  @@index([providerPriceId])
  @@map("workspace_subscriptions")
}

model WorkspaceBillingCheckout {
  id                    String                          @id @default(uuid()) @db.Uuid
  workspaceId           String                          @map("workspace_id") @db.Uuid
  createdById           String                          @map("created_by") @db.Uuid
  planKey               WorkspaceSubscriptionPlanKey    @map("plan_key")
  provider              String                          @db.VarChar(32)
  providerPriceId       String                          @map("provider_price_id") @db.VarChar(64)
  providerTransactionId String?                         @unique @map("provider_transaction_id") @db.VarChar(64)
  idempotencyKey        String                          @map("idempotency_key") @db.VarChar(200)
  assignmentTokenHash   String                          @unique @map("assignment_token_hash") @db.Char(64)
  status                WorkspaceBillingCheckoutStatus  @default(CREATED)
  expiresAt             DateTime                        @map("expires_at")
  completedAt           DateTime?                       @map("completed_at")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")
  workspace             Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerEvents        WorkspaceBillingProviderEvent[]

  @@unique([workspaceId, createdById, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("workspace_billing_checkouts")
}

model WorkspaceBillingProviderEvent {
  id                     String                      @id @default(uuid()) @db.Uuid
  workspaceId            String                      @map("workspace_id") @db.Uuid
  checkoutId             String?                     @map("checkout_id") @db.Uuid
  provider               String                      @db.VarChar(32)
  providerEventId        String                      @unique @map("provider_event_id") @db.VarChar(64)
  eventType              String                      @map("event_type") @db.VarChar(80)
  providerTransactionId  String?                     @map("provider_transaction_id") @db.VarChar(64)
  providerCustomerId     String?                     @map("provider_customer_id") @db.VarChar(64)
  providerSubscriptionId String?                     @map("provider_subscription_id") @db.VarChar(64)
  payloadHash            String                      @map("payload_hash") @db.Char(64)
