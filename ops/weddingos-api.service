[Unit]
Description=Sarbato local API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/andrei/weddingos-runtime
Environment=NODE_ENV=development
Environment=WEB_URL=http://127.0.0.1:43191
Environment=API_URL=http://127.0.0.1:4000
Environment=PORT=4000
Environment=DATABASE_URL=postgresql://weddingos_app:weddingos_app@127.0.0.1:54339/weddingos?schema=public
Environment=DATABASE_PURPOSE=persistent-runtime
Environment=SESSION_SECRET=weddingos-local-session-secret-change-before-production
Environment=MFA_ENCRYPTION_KEY=weddingos-local-mfa-encryption-key-change-production
Environment=MFA_ENCRYPTION_KEY_ID=local-mfa-v1
Environment="MFA_TOTP_ISSUER=Sarbato Local"
Environment=ADMIN_STEP_UP_TTL_SECONDS=600
Environment=CSRF_ENFORCEMENT=true
Environment=CSRF_TOKEN_TTL_SECONDS=1800
Environment=SESSION_COOKIE_NAME=weddingos_session
Environment="EMAIL_FROM=Sarbato <no-reply@sarbato.local>"
Environment=EMAIL_PROVIDER=smtp
Environment=SMTP_HOST=127.0.0.1
Environment=SMTP_PORT=1025
Environment=REDIS_URL=redis://127.0.0.1:56379
Environment=OUTBOX_ENCRYPTION_KEY=weddingos-local-outbox-encryption-key-change-production
Environment=OUTBOX_ENCRYPTION_KEY_ID=local-v1
Environment=OUTBOX_DECRYPTION_KEYS={}
Environment=OUTBOX_COMMAND_TTL_SECONDS=604800
Environment=WORKER_STALE_AFTER_SECONDS=45
Environment=MARKETING_SNAPSHOT_INTERVAL_SECONDS=900
Environment=MARKETING_SNAPSHOT_WINDOW_DAYS=365
Environment=MARKETING_SNAPSHOT_MIN_COHORT=20
Environment=MARKETING_SNAPSHOT_MAX_STALE_SECONDS=86400
Environment=LOG_LEVEL=info
Environment=FEATURE_MAGIC_LINK_ENABLED=true
Environment=FEATURE_MFA_ENABLED=true
Environment=METRICS_TOKEN=weddingos-local-metrics-token-change-production
Environment=ARTIFACT_ROOT=/home/andrei/weddingos-runtime/ops/artifacts/activity-exports
Environment=ARTIFACT_RETENTION_HOURS=24
Environment=ARTIFACT_MAX_BYTES=5242880
Environment=ARTIFACT_MAX_ROWS=10000
Environment=OBJECT_STORAGE_PROVIDER=minio
Environment=OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
Environment=OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:59000
Environment=OBJECT_STORAGE_REGION=us-east-1
Environment=OBJECT_STORAGE_BUCKET=weddingos-private
Environment=OBJECT_STORAGE_ACCESS_KEY=weddingos
Environment=OBJECT_STORAGE_SECRET_KEY=weddingos-local-storage-secret
Environment=OBJECT_STORAGE_FORCE_PATH_STYLE=true
Environment=CLAMAV_HOST=127.0.0.1
Environment=CLAMAV_PORT=53310
Environment=SIGNATURE_PROVIDER=fake
Environment=SIGNATURE_PROVIDER_SECRET=weddingos-signature-local-secret
Environment=PAYMENT_PROVIDER=fake
Environment=PAYMENT_PROVIDER_SECRET=weddingos-payment-local-secret
Environment=SUBSCRIPTION_PROVIDER=fake
Environment=SUBSCRIPTION_PROVIDER_SECRET=weddingos-subscription-local-secret
Environment=PAYOUT_PROVIDER=fake
Environment=PAYOUT_PROVIDER_SECRET=weddingos-payout-local-secret
Environment=REVIEW_EDIT_WINDOW_DAYS=30
Environment=SUBSCRIPTION_GRACE_PERIOD_DAYS=7
Environment=PAYOUT_HOLD_DAYS=7
Environment=PAYOUT_MINIMUM_MINOR=10000
Environment=PATH=/home/andrei/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/tmp
Environment=TEMP=/tmp
Environment=TMP=/tmp
ExecStart=/home/andrei/.nvm/versions/node/v22.22.3/bin/node apps/api/dist/main.js
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
