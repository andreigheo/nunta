[Unit]
Description=Sarbato Resend inbound relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sarbato-mail
Group=sarbato-mail
WorkingDirectory=/opt/sarbato-resend-relay/current
EnvironmentFile=/etc/sarbato-resend-relay.env
ExecStart=/usr/bin/node src/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sarbato-resend-relay
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
