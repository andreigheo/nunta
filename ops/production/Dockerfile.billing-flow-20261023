# Reuse the verified patched production runtimes; overlay application output only.
ARG SARBATO_WEB_BASE
ARG SARBATO_API_BASE
FROM ${SARBATO_WEB_BASE} AS web
USER root
RUN rm -rf /app/.next
COPY --chown=node:node web/.next /app/.next
ARG WEDDINGOS_BUILD_ID
RUN printf '%s\n' "$WEDDINGOS_BUILD_ID" > /app/.weddingos-build-id
LABEL org.opencontainers.image.revision=$WEDDINGOS_BUILD_ID
USER node

FROM ${SARBATO_API_BASE} AS api
USER root
RUN rm -rf /app/apps/api/dist
COPY --chown=node:node api/dist /app/apps/api/dist
ARG WEDDINGOS_BUILD_ID
RUN printf '%s\n' "$WEDDINGOS_BUILD_ID" > /app/.weddingos-build-id
LABEL org.opencontainers.image.revision=$WEDDINGOS_BUILD_ID
USER node
