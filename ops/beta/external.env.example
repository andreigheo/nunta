# Provider-neutral Controlled Beta environment. Do not copy local/test secrets.
NODE_ENV=beta
WEB_URL=https://beta.weddingos.<configured-domain>
API_URL=https://beta.weddingos.<configured-domain>
API_INTERNAL_URL=http://api:4000
DATABASE_PURPOSE=controlled-beta
STORAGE_PURPOSE=controlled-beta
BETA_RELEASE_VERSION=<signed-release-id>
BETA_PUBLIC_URL=https://beta.weddingos.<configured-domain>
BETA_ANALYTICS_ENABLED=false

# Dedicated managed services. Values must be supplied through a secret manager.
DATABASE_URL=<dedicated-beta-postgresql-app-url>
DATABASE_OWNER_URL=<dedicated-beta-postgresql-migration-url>
REDIS_URL=<dedicated-beta-rediss-url>
SESSION_SECRET=<dedicated-beta-secret-minimum-32-random-characters>
OUTBOX_ENCRYPTION_KEY=<dedicated-beta-key-minimum-32-random-characters>
OUTBOX_ENCRYPTION_KEY_ID=<dedicated-beta-key-id>

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://<private-beta-object-storage-endpoint>
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://<private-beta-object-storage-endpoint>
OBJECT_STORAGE_BUCKET=<dedicated-private-beta-bucket>
OBJECT_STORAGE_ACCESS_KEY=<dedicated-beta-access-key>
OBJECT_STORAGE_SECRET_KEY=<dedicated-beta-secret-key>
OBJECT_STORAGE_REGION=<configured-region>
OBJECT_STORAGE_FORCE_PATH_STYLE=false

EMAIL_PROVIDER=smtp
EMAIL_FROM=Sarbato <no-reply@<configured-domain>>
SMTP_HOST=<beta-smtp-host>
SMTP_PORT=587
SMTP_USER=<beta-smtp-user>
SMTP_PASSWORD=<beta-smtp-password>

SIGNATURE_PROVIDER=<sandbox-provider>
SIGNATURE_PROVIDER_URL=https://<sandbox-signature-provider>
SIGNATURE_PROVIDER_SECRET=<dedicated-beta-signature-secret>
PAYMENT_PROVIDER=<sandbox-provider>
PAYMENT_PROVIDER_URL=https://<sandbox-payment-provider>
PAYMENT_PROVIDER_SECRET=<dedicated-beta-payment-secret>
SUBSCRIPTION_PROVIDER=<sandbox-provider>
SUBSCRIPTION_PROVIDER_URL=https://<sandbox-subscription-provider>
SUBSCRIPTION_PROVIDER_SECRET=<dedicated-beta-subscription-secret>
PAYOUT_PROVIDER=<sandbox-provider>
PAYOUT_PROVIDER_URL=https://<sandbox-payout-provider>
PAYOUT_PROVIDER_SECRET=<dedicated-beta-payout-secret>

CLAMAV_HOST=<beta-malware-scanner-private-host>
CLAMAV_PORT=3310
BETA_ALERT_DESTINATION_URL=https://<configured-alert-destination>
BETA_BACKUP_DESTINATION=<dedicated-off-host-encrypted-destination>
