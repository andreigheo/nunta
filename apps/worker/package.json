{
  "name": "@weddingos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint --config ../../eslint.workspace.config.mjs src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "@aws-sdk/client-s3": "^3.890.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@weddingos/config": "workspace:*",
    "@weddingos/contracts": "workspace:^",
    "@weddingos/database": "workspace:*",
    "@weddingos/jobs": "workspace:*",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "ioredis": "^5.7.0",
    "exceljs": "4.4.0",
    "mammoth": "1.12.0",
    "nodemailer": "9.0.3",
    "pdf-parse": "1.1.1",
    "pino": "^9.9.4",
    "sharp": "0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/nodemailer": "8.0.1",
    "@types/pdf-parse": "1.1.5",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "3.2.6"
  }
}
