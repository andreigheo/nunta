{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-landing/types/**/*.ts",
    ".next-landing/dev/types/**/*.ts",
    ".next-landing-proof/types/**/*.ts",
    ".next-landing-proof/dev/types/**/*.ts",
    ".next-landing-vA/types/**/*.ts",
    ".next-landing-vA/dev/types/**/*.ts",
    ".next-landing-dev/types/**/*.ts",
    ".next-landing-dev/dev/types/**/*.ts",
    ".next-landing-vB/types/**/*.ts",
    ".next-landing-vB/dev/types/**/*.ts",
    ".next-sarbato-connected/types/**/*.ts",
    ".next-sarbato-connected/dev/types/**/*.ts",
    ".next-sarbato-dashboard-aligned/types/**/*.ts",
    ".next-sarbato-dashboard-aligned/dev/types/**/*.ts",
    ".next-sarbato-design-unified/types/**/*.ts",
    ".next-sarbato-design-unified/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps", "packages", "tests"]
}
